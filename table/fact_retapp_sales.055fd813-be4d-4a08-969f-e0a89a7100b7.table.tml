guid: 055fd813-be4d-4a08-969f-e0a89a7100b7
table:
  name: fact_retapp_sales
  db: PMMDB
  schema: RETAILAPPAREL
  db_table: fact_retapp_sales
  connection:
    name: Retail - Apparel
    fqn: c5c88447-e8aa-409e-86e3-d6eb3422dab3
  columns:
  - name: salesid
    db_column_name: salesid
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: productid
    db_column_name: productid
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: storeid
    db_column_name: storeid
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: quantitypurchased
    db_column_name: quantitypurchased
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: itemprice
    db_column_name: itemprice
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: sales
    db_column_name: sales
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: recorddate
    db_column_name: recorddate
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DATE
  joins_with:
  - name: c_dim_retapp_products
    destination:
      name: dim_retapp_products
      fqn: 7fd39fdb-9dfe-4954-b5dd-9a5d846085b0
    "on": "[fact_retapp_sales::productid] = [dim_retapp_products::productid]"
    type: INNER
  - name: c_dim_retapp_stores
    destination:
      name: dim_retapp_stores
      fqn: 3f3ae98c-8e8d-4445-b8b5-f7b6e991763c
    "on": "[fact_retapp_sales::storeid] = [dim_retapp_stores::storeid]"
    type: INNER
  properties:
    spotter_config:
      is_spotter_enabled: false
