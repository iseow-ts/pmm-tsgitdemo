        - column_id: Percent of Target
          show_headline: false
        - column_id: Target tracking(2022)
          show_headline: false
        - column_id: Target tracking(2023)
          show_headline: false
        - column_id: sales(2022)
          show_headline: false
        - column_id: sales(2023)
          show_headline: false
        - column_id: state
          show_headline: false
        ordered_column_ids:
        - Percent of Target
        - state
        - Target tracking(2023)
        - Target tracking(2022)
        - sales(2022)
        - sales(2023)
        - '% change'
