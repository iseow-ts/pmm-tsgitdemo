  - id: Viz_13
    answer:
      name: Sales targets across states
      tables:
      - id: (Sample) Retail - Apparel
        name: (Sample) Retail - Apparel
        fqn: cd252e5c-b552-49a8-821d-3eadaa049cca
      formulas:
      - id: formula_% change
        name: '% change'
        expr: "( [sales(2023)] - [sales(2022)] ) / [sales(2022)]"
        was_auto_generated: false
      - id: formula_Target tracking
        name: Target tracking
        expr: "if ( sum ( [sales] ) > 0 ) then concat ( '<div title=\"' , [formula_Percent of Target] , '% of 190k target\">' , '<svg xmlns=\"http://www.w3.org/2000/svg\" height=\"10\" width=\"123\">' , '<rect x=\"0\" y=\"0\" width=\"100\" height=\"10\" style=\"fill:rgb(242, 211, 200)\" />' , '<rect x=\"80\" y=\"0\" width=\"20\" height=\"10\" style=\"fill:rgb(250, 240, 206)\"/>' , '<rect x=\"100\" y=\"0\" width=\"20\" height=\"10\" style=\"fill:rgb(208, 234, 216)\"/>' , '<rect x=\"' , [formula_Percent of Target] , '\" y=\"0\" width=\"3\" height=\"10\" style=\"fill:rgb(0, 0, 0)\" />' , '</svg>' , '</div>' ) else ' '"
        was_auto_generated: false
      - id: formula_Percent of Target
        name: Percent of Target
        expr: to_string ( ( random ( ) * .5 + .5 ) * 100 )
        was_auto_generated: false
      search_query: "[date].2023 vs [date].2022 [sales] [formula_% change] [formula_Percent of Target] [formula_Target tracking] [sales(2023)] [state]"
      answer_columns:
      - name: '% change'
        custom_name: '% change'
        format:
          category: PERCENTAGE
          percentageFormatConfig:
            decimals: 1.0
          isCategoryEditable: true
      - name: Percent of Target
      - name: Target tracking(2022)
      - name: Target tracking(2023)
        custom_name: Target tracking
      - name: sales(2022)
      - name: sales(2023)
        custom_name: Sales
      - name: state
