  - id: Viz_9
    answer:
      name: Year-on-year growth across products
      tables:
      - id: (Sample) Retail - Apparel
        name: (Sample) Retail - Apparel
        fqn: cd252e5c-b552-49a8-821d-3eadaa049cca
      formulas:
      - id: formula_% change
        name: '% change'
        expr: "( [sales(2023)] - [sales(2022)] ) / [sales(2022)]"
        was_auto_generated: false
      search_query: "[product] [date].2023 vs [date].2022 [sales] [formula_% change]"
      answer_columns:
      - name: '% change'
        format:
          category: PERCENTAGE
          percentageFormatConfig:
            decimals: 1.0
          isCategoryEditable: true
      - name: product
      - name: sales(2022)
      - name: sales(2023)
      table:
        table_columns:
        - column_id: '% change'
          headline_aggregation: TABLE_AGGR
        - column_id: product
          headline_aggregation: COUNT_DISTINCT
        - column_id: sales(2022)
          headline_aggregation: TABLE_AGGR
        - column_id: sales(2023)
